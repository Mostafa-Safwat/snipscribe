{
    "name": "@snipscribe/typescript-client",
    "version": "1.0.0",
    "description": "OpenAPI client for snipscribe",
    "author": "OpenAPI-Generator",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup",
        "prepare": "npm run build",
        "generate": "JAVA_OPTS='-Dlog.level=warn' openapi-generator-cli generate",
        "build:watch": "onchange --await-write-finish 2000 -i '../../apps/api/swagger.json' -- yarn generateAndBuild",
        "process-json": "echo 'JSON file changed!'",
        "generateAndBuild": "yarn generate && yarn build"
    },
    "files": [
        "dist/**"
    ],
    "devDependencies": {
        "@openapitools/openapi-generator-cli": "^2.7.0",
        "onchange": "^7.1.0",
        "snipscribe-api": "*",
        "typescript": "^5.0"
    }
}
